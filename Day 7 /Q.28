#include <stdio.h>
int reverse_number(int num, int rev) {
    // Base case: when all digits are processed
    if (num == 0) {
        return rev;
    }
    
  
    rev = (rev * 10) + (num % 10);
    
    
    return reverse_number(num / 10, rev);
}

int main() {
    int num, result;

  
    printf("Enter an integer to reverse: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }
    if (num < 0) {
        result = -reverse_number(-num, 0);
    } else {
        result = reverse_number(num, 0);
    }

    printf("Reversed number: %d\n", result);

    return 0;
}
