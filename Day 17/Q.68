#include <stdio.h>

int main() {
    int n1, n2;
    
    printf("Enter the number of elements in the first array: ");
    scanf("%d", &n1);
    int arr1[n1];
    printf("Enter elements of the first array:\n");
    for (int i = 0; i < n1; i++) {
        scanf("%d", &arr1[i]);
    }


    printf("Enter the number of elements in the second array: ");
    scanf("%d", &n2);
    int arr2[n2];
    printf("Enter elements of the second array:\n");
    for (int i = 0; i < n2; i++) {
        scanf("%d", &arr2[i]);
    }

    int common[n1 < n2 ? n1 : n2]; 
    int k = 0; // Counter for common array


    for (int i = 0; i < n1; i++) {
        for (int j = 0; j < n2; j++) {
            if (arr1[i] == arr2[j]) {
                
                int isDuplicate = 0;
                for (int x = 0; x < k; x++) {
                    if (arr1[i] == common[x]) {
                        isDuplicate = 1;
                        break;
                    }
                }
                
                if (!isDuplicate) {
                    common[k] = arr1[i];
                    k++;
                }
                break; 
            }
        }
    }

    if (k > 0) {
        printf("\nCommon elements are: ");
        for (int i = 0; i < k; i++) {
            printf("%d ", common[i]);
        }
        printf("\n");
    } else {
        printf("\nNo common elements found.\n");
    }

    return 0;
}
