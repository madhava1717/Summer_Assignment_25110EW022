#include <stdio.h>

int main() {
    long long binary;
    int decimal = 0, base = 1, remainder;

    printf("Enter a binary number (using 0s and 1s): ");
    scanf("%lld", &binary);

    long long temp = binary; // Keep a copy for the final output

    while (temp > 0) {
        remainder = temp % 10;       // Extract the last digit
        decimal = decimal + remainder * base; // Update decimal total
        temp = temp / 10;            // Remove the last digit
        base = base * 2;             // Increase base power (2^0, 2^1, 2^2...)
    }

    
    printf("Binary number: %lld\n", binary);
    printf("Decimal equivalent: %d\n", decimal);

    return 0;
}
