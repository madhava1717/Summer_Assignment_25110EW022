#include <stdio.h>


int countSetBits(int n) {
    int count = 0;
    while (n > 0) {
        n = n & (n - 1); 
        count++;         
    }
    return count;
}

int main() {
    int num;

    // Get input from the user
    printf("Enter an integer: ");
    scanf("%d", &num);

    int totalSetBits = countSetBits(num);

    printf("Total set bits in %d is: %d\n", num, totalSetBits);

    return 0;
}
