#include <stdio.h>

int main() {
    int rows, cols;
    int i, j, row_sum;
  
    printf("Enter the number of rows and columns: ");
    scanf("%d %d", &rows, &cols);

    
    int matrix[rows][cols];

    
    printf("Enter the elements of the matrix:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("Element [%d][%d]: ", i, j);
            scanf("%d", &matrix[i][j]);
        }
    }

    printf("\n--- Row-wise Sum ---\n");
    for (i = 0; i < rows; i++) {
        row_sum = 0; // Reset sum for each new row
        
        for (j = 0; j < cols; j++) {
            row_sum += matrix[i][j]; // Accumulate elements of the current row
        }
        
        printf("Sum of elements in Row %d = %d\n", i + 1, row_sum);
    }

    return 0;
}
